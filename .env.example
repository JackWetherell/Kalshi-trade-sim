# Safe defaults only. NEVER put real keys in this file or anywhere in the repository.
# Paper and backtest modes need no credentials at all.
KALSHI_EDGE_MODE=paper

# DEMO environment only (mock funds). Provide via your shell or a file outside the repo.
KALSHI_DEMO_KEY_ID=<demo-key-id-placeholder>
KALSHI_DEMO_PRIVATE_KEY_PATH=</path/outside/repo/demo_private_key.pem>

# Production credentials are intentionally NOT listed here. They are provisioned by the
# human operator outside the repository, per docs/DEPLOYMENT.md, and are never read by
# backtest, paper, demo, tests or CI.
