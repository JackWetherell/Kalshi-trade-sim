# kalshi-edge DEMO trader (systemd --user unit). Kalshi demo environment, mock funds only.
#
# Needs HUMAN-PROVISIONED DEMO-ONLY credentials in an EnvironmentFile OUTSIDE the repo, e.g.
#   ~/.config/kalshi-edge/demo.env  (chmod 600) containing:
#     KALSHI_DEMO_KEY_ID=...
#     KALSHI_DEMO_PRIVATE_KEY_PATH=/home/you/.config/kalshi-edge/demo_private_key.pem
# Never put production credentials there. The leading "-" makes the file optional so the unit
# still parses; without credentials the demo trader fails closed and exits.
#
# THERE IS NO LIVE UNIT. Live trading is interactive-only (fresh TTY arming ceremony); arming
# tokens live in memory only, so a reboot or restart can never re-arm live trading.
#
# INSTALL: replace %REPO_DIR%, copy to ~/.config/systemd/user/, daemon-reload, enable --now.

[Unit]
Description=kalshi-edge demo trader (Kalshi demo env, mock funds)
Documentation=file://%REPO_DIR%/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%REPO_DIR%
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/kalshi-edge/demo.env
UnsetEnvironment=KALSHI_PROD_KEY_ID KALSHI_PROD_PRIVATE_KEY_PATH
ExecStart=/usr/bin/env uv run --frozen kalshi-edge run --mode demo --config configs/demo.yaml
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2 3

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%REPO_DIR%/var %REPO_DIR%/data %REPO_DIR%/reports %REPO_DIR%/.venv %h/.cache/uv
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
